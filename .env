# ============================================================
# Variables de entorno — Centro de soporte Eco-Retos (Netlify)
# Define estas variables en Netlify (Site settings > Environment
# variables) para el despliegue, o edita este archivo en local.
# ============================================================

# URL base del backend real (producción: URL permanente, no ngrok).
VITE_API_BASE_URL=https://accuracy-hypnotize-gawk.ngrok-free.dev

# Prefijos de los módulos del backend.
VITE_AUTH_BASE=/api/Auth
VITE_SUPPORT_BASE=/api/soporte
VITE_DENUNCIAS_BASE=/api/denuncias
VITE_NOTIFICACIONES_BASE=/api/notificaciones
VITE_IMAGENES_BASE=/api/imagenes

# Nombre visible del centro de soporte.
VITE_SUPPORT_NAME="Centro de soporte Eco-Retos"

# URL pública de la web de soporte (la que abrirá Flutter).
VITE_SUPPORT_WEB_URL=https://ecoreto.app/soporte

# Tiempo máximo de espera por petición HTTP (ms).
VITE_API_TIMEOUT_MS=20000

# MODO DEMO: true = datos locales; false = API real (backend con soporte + IA).
# En Netlify debe quedar en false.
VITE_DEMO_MODE=false
