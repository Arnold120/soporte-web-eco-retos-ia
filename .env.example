# ============================================================
# Variables de entorno — Centro de soporte Eco-Retos
# Copia este archivo como .env para desarrollo local.
#
# IMPORTANTE: nunca pongas claves secretas con el prefijo VITE_:
# se exponen al navegador. La clave del LLM debe vivir SOLO en el
# backend o en una Netlify Function.
# ============================================================

# URL base del backend real (en producción usa el dominio fijo, no ngrok).
VITE_API_BASE_URL=https://accuracy-hypnotize-gawk.ngrok-free.dev

# Prefijos de los módulos del backend.
VITE_AUTH_BASE=/api/Auth
VITE_SUPPORT_BASE=/api/soporte
VITE_DENUNCIAS_BASE=/api/denuncias
VITE_NOTIFICACIONES_BASE=/api/notificaciones
VITE_IMAGENES_BASE=/api/imagenes

# Nombre visible del centro de soporte.
VITE_SUPPORT_NAME="Centro de soporte Eco-Retos"

# URL pública de la web de soporte (la que abre la app Flutter).
VITE_SUPPORT_WEB_URL=https://ecoreto.app/soporte

# Tiempo máximo de espera por petición HTTP (ms).
VITE_API_TIMEOUT_MS=20000

# MODO DEMO:
#   true  -> datos locales (localStorage), ideal para probar sin backend.
#   false -> API real (recomendado y obligatorio en producción). El módulo
#            /api/soporte, la IA, los reportes, evidencias y notificaciones
#            funcionan contra el backend.
#
# NUNCA pongas aquí claves del proveedor de IA (OPENAI_API_KEY): van en el
# backend (appsettings.json -> Ia:ApiKey o variable de entorno Ia__ApiKey).
VITE_DEMO_MODE=false
